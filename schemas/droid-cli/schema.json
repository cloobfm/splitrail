{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Droid CLI Session Schema",
  "description": "Schema for Droid CLI (Factory AI) session data",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "Event type, typically 'session_start'"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique session identifier"
    },
    "title": {
      "type": "string",
      "description": "Session title or description"
    },
    "owner": {
      "type": "string",
      "description": "User who owns the session"
    },
    "version": {
      "type": "integer",
      "description": "Session format version"
    },
    "cwd": {
      "type": "string",
      "description": "Working directory where session was created"
    }
  },
  "required": ["type", "id", "title", "owner", "version", "cwd"]
}